.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python
__pycache__/
*.py[cod]
*.pyd
venv/
.venv/
backend/venv/
.pytest_cache/
.mypy_cache/

# Node.js
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm/

# Logs
*.log
